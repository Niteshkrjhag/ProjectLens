SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=your-supabase-secret-key
# Use Supabase's transaction/session pooler URL as appropriate for the workload.
DATABASE_URL=postgresql://postgres.your-project-ref:password@aws-0-region.pooler.supabase.com:6543/postgres
# Leave this on SQLite for an offline dry run; set it to DATABASE_URL to use Supabase/PostgreSQL.
PROJECTLENS_STORAGE_URL=sqlite:///./data/projectlens.db
GEMINI_API_KEY=
OLLAMA_API_KEY=
OLLAMA_HOST=https://ollama.com
GEMINI_MODEL=gemini-3.5-flash
OLLAMA_MODEL=gpt-oss:120b
